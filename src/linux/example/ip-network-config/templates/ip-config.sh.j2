#!/bin/sh
set -eu

# Generated by networkconfig-ip from JSON_INPUT.

{% for interface in data['ietf-interfaces:interfaces']['interface'] %}
{% if interface.type == "iana-if-type:ethernetCsmacd" and interface.enabled %}
# Parent interface: {{ interface.name }}
# Rename eth0 to the configured interface name if they differ on target.
# Qemu provides already eth1 so no renaming is needed and eth0 is used for debugging
if [ "{{ interface.name }}" != "eth0" ] && ip link show eth0 >/dev/null 2>&1; then
    if ip link show {{ interface.name }} >/dev/null 2>&1; then
        # {{ interface.name }} already exists, assign IP to eth0
        ip link set dev eth0 up
        if ! ip -4 addr show dev eth0 | grep -q "inet 192.168.11.2/"; then
            ip addr add 192.168.11.2/24 dev eth0
        fi
    else
        # {{ interface.name }} doesn't exist, rename eth0
        ip link set dev eth0 down
        ip link set dev eth0 name {{ interface.name }}
    fi
fi
{% if 'ietf-if-ethernet-like:ethernet-like' in interface and 'mac-address' in interface['ietf-if-ethernet-like:ethernet-like'] %}
ip link set dev {{ interface.name }} address {{ interface['ietf-if-ethernet-like:ethernet-like']['mac-address'] | replace('-', ':') }}
{% endif %}
ip link set dev {{ interface.name }}{% if 'ietf-if-extensions:max-frame-size' in interface %} mtu {{ interface['ietf-if-extensions:max-frame-size'] }}{% endif %} up


{% endif %}
{% endfor %}

{% for interface in data['ietf-interfaces:interfaces']['interface'] %}
{% if interface.type == "iana-if-type:l2vlan" and interface.enabled %}
# VLAN interface: {{ interface.name }}
# Use eth0 as parent when available, fall back to JSON-configured parent {{ interface['ietf-if-extensions:parent-interface'] }}.
_vlan_parent="${VLAN_PARENT:-{{ interface['ietf-if-extensions:parent-interface'] }}}"
if ! ip link show {{ interface.name }} >/dev/null 2>&1; then
    ip link add link "${_vlan_parent}" name {{ interface.name }} type vlan id {{ interface['ietf-if-extensions:encapsulation']['ietf-if-vlan-encapsulation:dot1q-vlan']['outer-tag']['vlan-id'] }}
fi
ip link set dev {{ interface.name }}{% if 'ietf-if-extensions:max-frame-size' in interface %} mtu {{ interface['ietf-if-extensions:max-frame-size'] }}{% endif %} up

{% if 'ietf-ip:ipv4' in interface and 'address' in interface['ietf-ip:ipv4'] %}
{% for addr in interface['ietf-ip:ipv4']['address'] %}
if ! ip -4 addr show dev {{ interface.name }} | grep -q "inet {{ addr['ip'] }}/{{ addr['prefix-length'] }}"; then
    ip addr add {{ addr['ip'] }}/{{ addr['prefix-length'] }} dev {{ interface.name }}
fi

{% endfor %}
{% endif %}
{% endif %}
{% endfor %}

{% if 'ietf-routing:routing' in data %}
{% for protocol in data['ietf-routing:routing']['control-plane-protocols']['control-plane-protocol'] %}
{% if 'static-routes' in protocol and 'ietf-ipv4-unicast-routing:ipv4' in protocol['static-routes'] %}
{% for route in protocol['static-routes']['ietf-ipv4-unicast-routing:ipv4']['route'] %}
{% if 'destination-prefix' in route and 'next-hop' in route and 'next-hop-address' in route['next-hop'] %}
ip route replace {{ route['destination-prefix'] }} via {{ route['next-hop']['next-hop-address'] }}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
