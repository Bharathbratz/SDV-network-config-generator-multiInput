# Android Network Configuration
# Hostname: {{ hostname }}
# Generated by sdn-config-generator (SDV)

{% for iface in interfaces %}
{% if iface.type == "vlan" %}
# VLAN {{ iface.vlan_id }} sub-interface: {{ iface.name }} (parent: {{ iface.parent }})
{% if iface.ip %}
setprop net.{{ iface.name | replace(".", "_") }}.ip {{ iface.ip }}
setprop net.{{ iface.name | replace(".", "_") }}.prefixlength {{ iface.prefix_length }}
setprop net.{{ iface.name | replace(".", "_") }}.netmask {{ iface.netmask }}
{% endif %}
{% endif %}
{% endfor %}

{% if routes %}
# Static Routes
{% for route in routes %}
ip route add {{ route.destination }} via {{ route.gateway }}
{% endfor %}
{% endif %}

{% if dns_servers %}
# DNS Servers
{% for dns in dns_servers %}
setprop net.dns{{ loop.index }} {{ dns }}
{% endfor %}
{% endif %}