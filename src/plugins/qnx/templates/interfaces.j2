{# QNX io-pkt Network Interface Configuration #}
# Hostname: {{ hostname }}
# Generated by sdn-config-generator (SDV)

{% for iface in interfaces %}
{% if iface.type == "ethernet" %}
# Physical interface: {{ iface.name }}
{% if iface.mac_address %}
# MAC: {{ iface.mac_address }}
{% endif %}
io-pkt-v6-hc -d e1000 -p tcpip if={{ iface.name }}

{% elif iface.type == "vlan" %}
# VLAN {{ iface.vlan_id }} on parent {{ iface.parent }}
vlan create {{ iface.name }} parent {{ iface.parent }} id {{ iface.vlan_id }}
{% if iface.ip %}
ifconfig {{ iface.name }} inet {{ iface.ip }} netmask {{ iface.netmask }} up
{% else %}
ifconfig {{ iface.name }} up
{% endif %}

{% endif %}
{% endfor %}