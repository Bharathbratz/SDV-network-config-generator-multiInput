#!/bin/sh
# ip-config.sh — generated by linux network config generator for host: {{ input_file }}
# Configures the Linux network stack using iproute2 ip(8) commands.
# Each operation is idempotent so the script can be safely re-run.
set -eu

# Allow tests / QEMU to override the physical parent interface name.
# On real hardware VLAN_PARENT should be left unset.
VLAN_PARENT="${VLAN_PARENT:-}"

# ---------------------------------------------------------------------------
# 1. Physical (parent) interfaces
# ---------------------------------------------------------------------------
{%- for iface in data['ietf-interfaces:interfaces']['interface'] %}
{%- if iface.type == "iana-if-type:ethernetCsmacd" and iface.enabled %}

# --- Parent: {{ iface.name }} ---
# Rename from kernel-assigned name to IETF-configured name when necessary.
# QEMU guests usually present eth0; real hardware may use a different name.
if [ "{{ iface.name }}" != "eth0" ] && ip link show eth0 >/dev/null 2>&1; then
    if ip link show {{ iface.name }} >/dev/null 2>&1; then
        ip link set dev eth0 up
    else
        ip link set dev eth0 down
        ip link set dev eth0 name {{ iface.name }}
    fi
fi
{%- if 'ietf-if-ethernet-like:ethernet-like' in iface and 'mac-address' in iface['ietf-if-ethernet-like:ethernet-like'] %}
ip link set dev {{ iface.name }} address {{ iface['ietf-if-ethernet-like:ethernet-like']['mac-address'] | replace('-', ':') }}
{%- endif %}
ip link set dev {{ iface.name }}{% if 'ietf-if-extensions:max-frame-size' in iface %} mtu {{ iface['ietf-if-extensions:max-frame-size'] }}{% endif %} up
{%- endif %}
{%- endfor %}

# ---------------------------------------------------------------------------
# 2. VLAN sub-interfaces
# ---------------------------------------------------------------------------
{%- for iface in data['ietf-interfaces:interfaces']['interface'] %}
{%- if iface.type == "iana-if-type:l2vlan" and iface.enabled %}

# --- VLAN: {{ iface.name }} (id={{ iface['ietf-if-extensions:encapsulation']['ietf-if-vlan-encapsulation:dot1q-vlan']['outer-tag']['vlan-id'] }}) ---
_parent="${VLAN_PARENT:-{{ iface['ietf-if-extensions:parent-interface'] }}}"
if ! ip link show {{ iface.name }} >/dev/null 2>&1; then
    ip link add link "${_parent}" name {{ iface.name }} type vlan id {{ iface['ietf-if-extensions:encapsulation']['ietf-if-vlan-encapsulation:dot1q-vlan']['outer-tag']['vlan-id'] }}
fi
ip link set dev {{ iface.name }}{% if 'ietf-if-extensions:max-frame-size' in iface %} mtu {{ iface['ietf-if-extensions:max-frame-size'] }}{% endif %} up
{%- if 'ietf-ip:ipv4' in iface and 'address' in iface['ietf-ip:ipv4'] %}
{%- for addr in iface['ietf-ip:ipv4']['address'] %}
if ! ip -4 addr show dev {{ iface.name }} | grep -q "inet {{ addr['ip'] }}/{{ addr['prefix-length'] }}"; then
    ip addr add {{ addr['ip'] }}/{{ addr['prefix-length'] }} dev {{ iface.name }}
fi
{%- endfor %}
{%- endif %}
{%- endif %}
{%- endfor %}

# ---------------------------------------------------------------------------
# 3. Static routes
# ---------------------------------------------------------------------------
{%- if 'ietf-routing:routing' in data %}
{%- for protocol in data['ietf-routing:routing']['control-plane-protocols']['control-plane-protocol'] %}
{%- if 'static-routes' in protocol and 'ietf-ipv4-unicast-routing:ipv4' in protocol['static-routes'] %}
{%- for route in protocol['static-routes']['ietf-ipv4-unicast-routing:ipv4']['route'] %}
{%- if 'destination-prefix' in route and 'next-hop' in route and 'next-hop-address' in route['next-hop'] %}
{%- set dest = 'default' if route['destination-prefix'] == '0.0.0.0/0' else route['destination-prefix'] %}
{%- set outgoing = route['next-hop'].get('outgoing-interface', '') %}
ip route replace {{ dest }} via {{ route['next-hop']['next-hop-address'] }}{% if outgoing %} dev {{ outgoing }}{% endif %}

{%- endif %}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}
