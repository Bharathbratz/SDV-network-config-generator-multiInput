# Linux Network Configuration
# Hostname: {{ hostname }}
# Generated by sdn-config-generator (SDV)

{% for iface in interfaces %}
{% if iface.type == "ethernet" %}
# Physical interface: {{ iface.name }}
{% if iface.mac_address %}
# MAC: {{ iface.mac_address }}
{% endif %}
auto {{ iface.name }}
iface {{ iface.name }} inet manual
    up ip link set {{ iface.name }} up

{% elif iface.type == "vlan" %}
# VLAN {{ iface.vlan_id }} sub-interface on {{ iface.parent }}
auto {{ iface.name }}
{% if iface.ip %}
iface {{ iface.name }} inet static
    address {{ iface.ip }}
    netmask {{ iface.netmask }}
    vlan-raw-device {{ iface.parent }}
{% else %}
iface {{ iface.name }} inet manual
    vlan-raw-device {{ iface.parent }}
{% endif %}

{% endif %}
{% endfor %}
{% if routes %}
# Static Routes
{% for route in routes %}
up ip route add {{ route.destination }} via {{ route.gateway }}
{% endfor %}
{% endif %}
{% if dns_servers %}
# DNS Servers
{% for dns in dns_servers %}
dns-nameservers {{ dns }}
{% endfor %}
{% endif %}