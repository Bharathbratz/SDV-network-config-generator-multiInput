! Switch CPU Network Configuration
! Hostname: {{ hostname }}
! Generated by sdn-config-generator

hostname {{ hostname }}
!
{% for iface in interfaces %}
{% if iface.type == "ethernet" %}
interface {{ iface.name }}
{% if iface.mac_address %}
 ! MAC: {{ iface.mac_address }}
{% endif %}
 no shutdown
!
{% elif iface.type == "vlan" %}
interface vlan {{ iface.vlan_id }}
{% if iface.ip %}
 ip address {{ iface.ip }} {{ iface.netmask }}
{% else %}
 no ip address
{% endif %}
 no shutdown
!
{% endif %}
{% endfor %}

{% if routes %}
! Static Routes
{% for route in routes %}
ip route {{ route.destination }} {{ route.gateway }}
{% endfor %}
{% endif %}

{% if dns_servers %}
! DNS Servers
{% for dns in dns_servers %}
ip name-server {{ dns }}
{% endfor %}
{% endif %}
