/* MCU Network Configuration */
/* Hostname: {{ hostname }} */
/* Generated by sdn-config-generator */

#ifndef NETWORK_CONFIG_H
#define NETWORK_CONFIG_H

{% for iface in interfaces %}
{% if iface.type == "ethernet" %}
/* Physical Interface: {{ iface.name }} */
{% if iface.mac_address %}
#define {{ iface.name | upper | replace(".", "_") }}_MAC     "{{ iface.mac_address }}"
{% endif %}

{% elif iface.type == "vlan" %}
/* VLAN Interface: {{ iface.name }} (VLAN {{ iface.vlan_id }} on {{ iface.parent }}) */
#define {{ iface.name | upper | replace(".", "_") }}_VLAN_ID  {{ iface.vlan_id }}
{% if iface.ip %}
#define {{ iface.name | upper | replace(".", "_") }}_IP       "{{ iface.ip }}"
#define {{ iface.name | upper | replace(".", "_") }}_NETMASK  "{{ iface.netmask }}"
#define {{ iface.name | upper | replace(".", "_") }}_PREFIX   {{ iface.prefix_length }}
{% endif %}

{% endif %}
{% endfor %}

{% if routes %}
/* Static Routes */
#define ROUTE_COUNT  {{ routes | length }}

{% for route in routes %}
#define ROUTE_{{ loop.index0 }}_DEST  "{{ route.destination }}"
#define ROUTE_{{ loop.index0 }}_GW    "{{ route.gateway }}"
{% endfor %}
{% endif %}

{% if dns_servers %}
/* DNS Servers */
{% for dns in dns_servers %}
#define DNS_SERVER_{{ loop.index0 }}  "{{ dns }}"
{% endfor %}
{% endif %}

#endif /* NETWORK_CONFIG_H */
